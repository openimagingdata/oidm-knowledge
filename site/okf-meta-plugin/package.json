{
  "name": "okf-meta-plugin",
  "version": "0.2.0",
  "description": "OkfMeta component for Quartz - renders OKF 0.2 frontmatter (type, status, generated, verified, stale_after, sources) as a badge row and source list",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./components": {
      "import": "./dist/components/index.js"
    }
  },
  "peerDependencies": {
    "preact": ">=10.0.0"
  },
  "quartz": {
    "name": "okf-meta-plugin",
    "displayName": "OKF Meta",
    "category": "component",
    "version": "0.2.0",
    "quartzVersion": ">=5.0.0",
    "defaultOrder": 50,
    "defaultEnabled": true,
    "defaultOptions": {},
    "components": {
      "OkfMeta": {
        "displayName": "OKF Meta",
        "defaultPosition": "beforeBody",
        "defaultPriority": 15
      }
    }
  }
}
